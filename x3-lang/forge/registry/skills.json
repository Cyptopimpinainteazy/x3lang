  {
    "id": "spend",
    "name": "Armory Access",
    "description": "Spend one asset under hard caps. Compiles to the mandate's spend, caps, refund address, slippage and fee bounds. Enforced by x3-guard.",
    "category": "pay",
    "risk": 3,
    "cost": 3,
    "requires": ["read_balances"],
    "conflicts": [],
    "needs": ["payees"],
    "compiles_to": {"kind": "mandate", "clauses": ["spend", "per_payment", "per_24h", "refund_to", "require slippage", "require fees"]},
    "enforced_by": "x3-guard",
    "params": [
      {"id": "asset", "label": "Spend asset", "type": "asset", "default": "Solana.USDC"},
      {"id": "per_payment", "label": "Max per payment", "type": "amount", "of": "asset", "min": "0.000001", "max": "1000000", "default": "50"},
      {"id": "per_24h", "label": "Max per rolling 24h", "type": "amount", "of": "asset", "min": "0.000001", "max": "10000000", "default": "200"},
      {"id": "refund_to", "label": "Refund address (spend chain)", "type": "address", "of": "asset", "default": "4Nd1mzi8Y1QYxJt9wZWBYZpG7S4pYkZs6YzD3Vt9aBcD"},
      {"id": "max_slippage", "label": "Max slippage (%)", "type": "percent", "min": "0.01", "max": "5", "default": "1"},
      {"id": "max_fees", "label": "Max fees (bps)", "type": "bps", "min": 0, "max": 500, "default": 100}
    ],
    "mutation": {"part": "core", "scale_by": "per_24h"}
  },
  {
    "id": "payees",
    "name": "Payee Lock",
