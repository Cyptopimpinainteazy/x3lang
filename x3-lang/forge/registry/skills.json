      {"id": "recipients", "label": "Allowed recipients", "type": "receiver_list", "of": "assets", "min": 1, "max": 16, "default": ["x3-demo.near"]}
    ],
    "mutation": {"part": "tendrils", "count_by": "recipients"}
  },
