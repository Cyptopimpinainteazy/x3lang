# X3CCP `control` grammar (GBNF) for constrained decoding with llama.cpp-compatible runtimes.
#
# A model sampling under this grammar can only emit syntactically valid `control` blocks.
# Syntax is not authority: x3ccp.compile_source() still checks semantics (known functions and
# parameters, types, bounds, conflicts, checksums, expiry), and nothing runs until the
# contract owner installs the compiled bytes in their own transaction.
# Verified against every committed X3CCP source by x3-lang/tests/test_x3ccp_ai.py.

root      ::= blank* "control" sp ident ows "{" eol line* ows "}" ows comment? blank*
line      ::= ows clause ows ";"? ows comment? eol | blank
blank     ::= ows comment? eol
clause    ::= target | owner | callers | fn | limit | rate | expires

target    ::= "target" sp chain sp addr
chain     ::= "base-sepolia" | "local" | "base" | "ethereum" | "mainnet" | "optimism" | "arbitrum" | "bsc"
owner     ::= "owner" sp addr
callers   ::= "allow" sp "callers" sp addr (ows "," ows addr)*
fn        ::= "allow" sp "fn" sp ident ows "(" ows params? ows ")"
params    ::= param (ows "," ows param)*
param     ::= type sp ident
type      ::= "address" | "bool" | "bytes32" | "uint" bits?
bits      ::= "8" | "16" | "24" | "32" | "40" | "48" | "56" | "64" | "72" | "80" | "88" | "96"
            | "104" | "112" | "120" | "128" | "136" | "144" | "152" | "160" | "168" | "176"
            | "184" | "192" | "200" | "208" | "216" | "224" | "232" | "240" | "248" | "256"

limit     ::= "limit" sp ref ows cmp ows num
            | "limit" sp ref ows "==" ows value
            | "limit" sp ref sp "in" sp value (ows "," ows value)*
cmp       ::= "<=" | ">="
rate      ::= "rate" sp ref sp "per" sp dur ows "<=" ows num
            | "rate" sp ident sp "calls" sp "per" sp dur ows "<=" ows num
expires   ::= "expires" sp dur | "expires" sp "at" sp iso

ref       ::= ident "." ident
value     ::= addr | word | "true" | "false" | num
addr      ::= "0x" [0-9a-fA-F]{40}
word      ::= "0x" [0-9a-fA-F]{64}
num       ::= [0-9] [0-9_]* | "0x" [0-9a-fA-F]+
dur       ::= [0-9] [0-9_]* [smhd]
iso       ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2} "T" [0-9]{2} ":" [0-9]{2} ":" [0-9]{2} "Z"
ident     ::= [A-Za-z_] [A-Za-z0-9_]*

comment   ::= "//" [^\n]*
sp        ::= [ \t]+
ows       ::= [ \t]*
eol       ::= "\r"? "\n"
