// x3_route_doge_to_near.x3 — 100 DOGE on Dogecoin to USDC on NEAR, through 1Click.
//
// DRY QUOTE REFERENCE ONLY. `D596YFweJQuHY1BbjazZYmAbt8jJXaDhSF` is a checksummed placeholder
// (hash 0x…01, no known key) and `x3-demo.near` a demo account: replace both before any wallet
// authorization, and never deposit to a quote produced for them. UTXO addresses are checked
// against their own checksum and version bytes, so a Bitcoin or Litecoin address is refused here.
//
// 100 DOGE in base units: 8 decimals, so 1e10.
intent x3_route_doge_to_near {
    from Dogecoin.DOGE amount 10000000000 receiver D596YFweJQuHY1BbjazZYmAbt8jJXaDhSF
    to Near.USDC receiver x3-demo.near
    route {
        bridge NearIntents Dogecoin.DOGE -> Near.USDC;
    }
    require slippage <= 1%
    require fees <= 100 bps
    require nonce unused x3_route_doge_near_001
    timeout 30m refund Dogecoin.DOGE
    on_fail rollback
}
