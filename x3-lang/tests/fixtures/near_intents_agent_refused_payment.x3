// The allowed agent payment with one deterministic breach: a recipient outside the mandate.
// `near_agent.py register-args` emits this policy without asking 1Click for a quote. The
// x3-guard contract fixture then executes `agent_register_intent` and must panic with
// X3_MANDATE_DENIED / mandate_recipient.
intent near_intents_agent_refused_payment {
    from Solana.USDC amount 25000000 receiver 4Nd1mzi8Y1QYxJt9wZWBYZpG7S4pYkZs6YzD3Vt9aBcD
    to Near.USDC receiver attacker.near
    route {
        bridge NearIntents Solana.USDC -> Near.USDC min_receive 24800000;
    }
    under mandate x3-owner.near
    require slippage <= 0.5%
    require fees <= 100 bps
    require nonce unused agent_refused_001
    timeout 10m refund Solana.USDC
    on_fail rollback
}
